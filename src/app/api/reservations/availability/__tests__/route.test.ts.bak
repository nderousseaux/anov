import { describe, it, expect, vi } from "vitest";
import { NextRequest } from "next/server";

// Mock at the very beginning, before any imports
vi.mock("@/lib/prisma", () => ({
  prisma: {
    restaurantSettings: {
      findFirst: vi.fn().mockResolvedValue({
        id: 1,
        mealDuration: 90,
        openingDays: JSON.stringify([2, 3, 4, 5, 6]),
        openingSlots: JSON.stringify(["12:00", "19:00"]),
      }),
    },
    dayOverride: {
      findUnique: vi.fn().mockResolvedValue(null),
      findMany: vi.fn().mockResolvedValue([]),
    },
    reservation: {
      findMany: vi.fn().mockResolvedValue([]),
    },
    table: {
      findMany: vi.fn().mockResolvedValue([
        { id: 1, name: "Table 1", capacity: 2, posX: 0, posY: 0 },
      ]),
    },
  },
}));

// Mock the availability module with mock functions
vi.mock("@/lib/availability", () => ({
  getSlotsWithAvailability: vi.fn().mockResolvedValue([
    { time: "12:00", available: true },
    { time: "19:00", available: true },
  ]),
  getUnavailableDatesForMonth: vi.fn().mockResolvedValue([]),
}));

describe("Reservations Availability API", () => {
  describe("GET /api/reservations/availability", () => {
    it("returns 400 if guests is missing", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
      const data = await res.json();
      expect(data.error).toBe("guests invalide (1 à 4)");
    });

    it("returns 400 if guests is less than 1", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?guests=0"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
    });

    it("returns 400 if guests is more than 4", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?guests=5"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
    });

    it("returns 400 if guests is not a number", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?guests=abc"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
    });

    it("returns unavailable dates for month", async () => {
      vi.resetAllMocks();
      const { getSlotsWithAvailability, getUnavailableDatesForMonth } = await import("@/lib/availability");
      getSlotsWithAvailability.mockResolvedValue([]);
      getUnavailableDatesForMonth.mockResolvedValue(["2024-06-15", "2024-06-16"]);

      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?month=2024-06&guests=2"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(200);
      const data = await res.json();
      expect(data.unavailableDates).toEqual(["2024-06-15", "2024-06-16"]);
    });

    it("returns 400 for invalid month format", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?month=2024-6&guests=2"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
      const data = await res.json();
      expect(data.error).toBe("month invalide");
    });

    it("returns slots for specific date", async () => {
      const { getSlotsWithAvailability, getUnavailableDatesForMonth } = await import("@/lib/availability");
      getSlotsWithAvailability.mockResolvedValue([
        { time: "12:00", available: true },
        { time: "19:00", available: true },
      ]);
      getUnavailableDatesForMonth.mockResolvedValue([]);

      const { GET } = await import("../route");
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const tomorrowStr = tomorrow.toISOString().split("T")[0];

      const req = new NextRequest(
        new URL(`http://localhost:3000/api/reservations/availability?date=${tomorrowStr}&guests=2`),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(200);
      const data = await res.json();
      expect(data.slots).toHaveLength(2);
    });

    it("returns empty slots for past dates", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?date=2020-06-15&guests=2"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(200);
      const data = await res.json();
      expect(data.slots).toEqual([]);
    });

    it("returns 400 for invalid date format", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?date=15-06-2024&guests=2"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
    });

    it("validates guests is an integer", async () => {
      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL("http://localhost:3000/api/reservations/availability?guests=2.5"),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(400);
    });

    it("returns slots for today if date is today", async () => {
      const today = new Date();
      const todayStr = today.toISOString().split("T")[0];

      vi.resetAllMocks();
      const { getSlotsWithAvailability } = await import("@/lib/availability");
      getSlotsWithAvailability.mockResolvedValue([
        { time: "19:00", available: true },
      ]);

      const { GET } = await import("../route");
      const req = new NextRequest(
        new URL(`http://localhost:3000/api/reservations/availability?date=${todayStr}&guests=2`),
        {
          method: "GET",
        },
      );
      const res = await GET(req as any);

      expect(res.status).toBe(200);
      const data = await res.json();
      expect(data.slots).toHaveLength(1);
    });
  });
});
