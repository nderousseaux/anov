import { describe, it, expect, vi, beforeEach } from "vitest";
import type { TableInfo } from "../tables";

// Mock prisma BEFORE importing tables.ts that depend on it
vi.mock("../prisma", () => ({
  prisma: {
    table: {
      findMany: vi.fn().mockResolvedValue([]),
    },
    reservation: {
      findMany: vi.fn().mockResolvedValue([]),
    },
  },
}));

// Import tables.ts AFTER mocking prisma
const tablesModule = await import("../tables");

// Get TIER_BY_GUESTS from the module
const {
  TIER_BY_GUESTS,
  computeServiceTurns,
  getTotalTableCapacity,
  computeBusyTableIds,
  pickTable,
  assignTable,
} = tablesModule;

describe("tables", () => {
  describe("TIER_BY_GUESTS", () => {
    it("defines correct tier mapping", () => {
      expect(TIER_BY_GUESTS).toEqual({
        1: [2],
        2: [2, 3],
        3: [3, 4],
        4: [4],
      });
    });
  });

  describe("computeServiceTurns", () => {
    it("returns 0 for empty slots", () => {
      expect(computeServiceTurns([], 90)).toBe(0);
    });

    it("computes 1 turn for single slot", () => {
      expect(computeServiceTurns(["12:00"], 90)).toBe(1);
    });

    it("computes turns correctly for consecutive slots", () => {
      expect(
        computeServiceTurns(["12:00", "12:30", "13:00", "13:30"], 90),
      ).toBe(2);
    });

    it("computes turns with meal duration of 60 minutes", () => {
      expect(
        computeServiceTurns(["12:00", "12:30", "13:00", "13:30"], 60),
      ).toBe(2);
    });

    it("computes turns with larger meal duration", () => {
      expect(computeServiceTurns(["12:00", "12:30", "13:00"], 120)).toBe(1);
    });

    it("computes turns with non-consecutive slots", () => {
      expect(computeServiceTurns(["12:00", "14:00", "16:00"], 90)).toBe(3);
    });
  });

  describe("getTotalTableCapacity", () => {
    it("sums capacity of all tables", () => {
      const tables = [
        { id: 1, name: "Table 1", capacity: 2, posX: 0, posY: 0 },
        { id: 2, name: "Table 2", capacity: 4, posX: 1, posY: 0 },
        { id: 3, name: "Table 3", capacity: 6, posX: 2, posY: 0 },
      ] as TableInfo[];
      expect(getTotalTableCapacity(tables)).toBe(12);
    });

    it("handles empty tables array", () => {
      expect(getTotalTableCapacity([])).toBe(0);
    });

    it("handles single table", () => {
      const tables = [
        { id: 1, name: "Table 1", capacity: 2, posX: 0, posY: 0 },
      ] as TableInfo[];
      expect(getTotalTableCapacity(tables)).toBe(2);
    });

    it("handles tables with different capacities", () => {
      const tables = [
        { id: 1, name: "Table 1", capacity: 2, posX: 0, posY: 0 },
        { id: 2, name: "Table 2", capacity: 4, posX: 1, posY: 0 },
      ] as TableInfo[];
      expect(getTotalTableCapacity(tables)).toBe(6);
    });
  });

  describe("computeBusyTableIds", () => {
    beforeEach(() => {
      vi.clearAllMocks();
    });

    it("returns empty set when no reservations", () => {
      const reservations = [];
      const busy = computeBusyTableIds(reservations, "19:00", 90);
      expect(busy).toEqual(new Set());
    });

    it("marks table as busy when reservation time is within blocking window", () => {
      const reservations = [
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: 1 },
      ];
      const busy = computeBusyTableIds(reservations, "19:00", 90);
      expect(busy).toEqual(new Set([1]));
    });

    it("does not mark table as busy when outside blocking window", () => {
      const reservations = [
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: 1 },
      ];
      const busy = computeBusyTableIds(reservations, "17:00", 90);
      expect(busy).toEqual(new Set());
    });

    it("handles multiple reservations on different tables", () => {
      const reservations = [
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: 1 },
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: 2 },
        { date: new Date("2024-06-15T20:00:00.000Z"), tableId: 3 },
      ];
      const busy = computeBusyTableIds(reservations, "19:30", 90);
      expect(busy).toEqual(new Set([1, 2, 3]));
    });

    it("handles reservations without tableId (null)", () => {
      const reservations = [
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: null },
      ];
      const busy = computeBusyTableIds(reservations, "19:00", 90);
      expect(busy).toEqual(new Set());
    });

    it("correctly handles edge case at blocking window boundary", () => {
      const reservations = [
        { date: new Date("2024-06-15T19:00:00.000Z"), tableId: 1 },
      ];
      const busy = computeBusyTableIds(reservations, "17:30", 90);
      expect(busy).toEqual(new Set([1]));
    });
  });

  describe("pickTable", () => {
    const tables = [
      { id: 1, name: "Table 1", capacity: 2, posX: 0, posY: 0 },
      { id: 2, name: "Table 2", capacity: 2, posX: 1, posY: 0 },
      { id: 3, name: "Table 3", capacity: 3, posX: 2, posY: 0 },
      { id: 4, name: "Table 4", capacity: 4, posX: 3, posY: 0 },
    ] as TableInfo[];

    it("picks smallest fitting table for isToday=false (tier mode)", () => {
      expect(pickTable(tables, new Set(), 2, false)?.id).toBe(1);
    });

    it("respects tier hierarchy for 1 guest", () => {
      expect(pickTable(tables, new Set(), 1, false)?.id).toBe(1);
    });

    it("respects tier hierarchy for 3 guests", () => {
      expect(pickTable(tables, new Set(), 3, false)?.id).toBe(3);
    });

    it("respects tier hierarchy for 4 guests", () => {
      expect(pickTable(tables, new Set(), 4, false)?.id).toBe(4);
    });

    it("falls back to larger table in tier when smaller is busy", () => {
      expect(pickTable(tables, new Set([1]), 2, false)?.id).toBe(2);
    });

    it("returns null when no table available in tier", () => {
      expect(pickTable(tables, new Set([1, 2, 3, 4]), 2, false)).toBeNull();
    });

    it("ignores tier hierarchy for isToday=true", () => {
      expect(pickTable(tables, new Set(), 3, true)?.id).toBe(3);
    });

    it("picks smallest fitting table for isToday=true", () => {
      expect(pickTable(tables, new Set(), 1, true)?.id).toBe(1);
    });

    it("filters out busy tables for isToday=true", () => {
      expect(pickTable(tables, new Set([1, 2, 3]), 2, true)?.id).toBe(4);
    });

    it("handles empty tables array", () => {
      expect(pickTable([], new Set(), 2, false)).toBeNull();
    });
  });

  describe("assignTable", () => {
    it("fetches tables and reservations, then assigns table", async () => {
      expect(assignTable).toBeDefined();
      expect(typeof assignTable).toBe("function");
    });
  });
});
