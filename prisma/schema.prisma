generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reservation {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  name                String
  email               String
  phone               String?
  date                DateTime
  guests              Int
  specialRequest      String?
  wantsSmsReminder    Boolean           @default(false)
  status              ReservationStatus @default(PENDING_PAYMENT)
  stripeSessionId     String?           @unique
  expiresAt           DateTime?
  reminderEmailSent   Boolean           @default(false)
  reminderSmsSent     Boolean           @default(false)
  cancelToken         String            @unique @default(cuid())
  transactionExpireAt DateTime?
  depositPaidCents    Int?
  tableId             Int?
  table               Table?            @relation(fields: [tableId], references: [id])
}

model Table {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  capacity     Int
  posX         Float         @default(0)
  posY         Float         @default(0)
  reservations Reservation[]
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model RestaurantSettings {
  id                   Int    @id @default(1)
  maxCovers            Int    @default(20)
  mealDuration         Int    @default(90)
  openingDays          String @default("[2,3,4,5,6]")
  openingSlots         String @default("[\"12:00\",\"12:30\",\"13:00\",\"13:30\",\"19:00\",\"19:30\",\"20:00\",\"20:30\",\"21:00\",\"21:30\"]")
  depositPerGuestCents Int    @default(2000)
  daysBeforeReminder   Int    @default(1) // Nombre de jours avant la réservation pour envoyer un rappel
}

model DayOverride {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  closed       Boolean  @default(false)
  maxCovers    Int?
  openingSlots String?
}

model GiftCard {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  code                String         @unique
  amount              Float
  recipientEmail      String?
  personalMessage     String?
  isPaid              Boolean        @default(false)
  status              GiftCardStatus @default(IN_PROGRESS_PAYMENT)
  stripeSessionId     String?        @unique
  expiresAt           DateTime?
  transactionExpireAt DateTime?
  usedAt              DateTime?
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_PROGRESS_PAYMENT
  EXPIRED
}

enum GiftCardStatus {
  IN_PROGRESS_PAYMENT
  ACTIVE
  USED
  EXPIRED
}
