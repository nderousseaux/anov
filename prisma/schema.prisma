generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Réservation client ────────────────────────────────────────────────────────
model Reservation {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Coordonnées client
  name              String
  email             String
  phone             String?

  // Détails de la réservation
  date              DateTime
  guests            Int
  specialRequest    String?

  // Options
  wantsSmsReminder  Boolean           @default(false)

  // Statut
  status            ReservationStatus @default(PENDING_PAYMENT)

  // Paiement Stripe
  stripeSessionId   String?           @unique

  // Expiration (pour IN_PROGRESS_PAYMENT)
  expiresAt         DateTime?

  // Rappels envoyés
  reminderEmailSent Boolean           @default(false)
  reminderSmsSent   Boolean           @default(false)

  // Token d'annulation (lien dans l'email)
  cancelToken       String            @unique @default(cuid())
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_PROGRESS_PAYMENT
  EXPIRED
}

// ─── Compte administrateur ────────────────────────────────────────────────────
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Paramètres du restaurant ─────────────────────────────────────────────────
// Singleton (id = 1 toujours)
model RestaurantSettings {
  id                   Int    @id @default(1)
  maxCovers            Int    @default(20)
  mealDuration         Int    @default(90)
  openingDays          String @default("[2,3,4,5,6]")
  openingSlots         String @default("[\"12:00\",\"12:30\",\"13:00\",\"13:30\",\"19:00\",\"19:30\",\"20:00\",\"20:30\",\"21:00\",\"21:30\"]")
  depositPerGuestCents Int    @default(2000)
}

// ─── Override pour un jour spécifique ─────────────────────────────────────────
// Permet de fermer un jour habituellement ouvert, ou d'ouvrir/personnaliser
// un jour avec des créneaux et/ou des couverts différents.
model DayOverride {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  closed       Boolean  @default(false)
  maxCovers    Int?
  openingSlots String?
}

// ─── Chèques Cadeaux ──────────────────────────────────────────────────────────
model GiftCard {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  code                String            @unique
  amount              Float
  recipientEmail      String?
  personalMessage     String?
  isPaid              Boolean           @default(false)

  status              GiftCardStatus    @default(IN_PROGRESS_PAYMENT)

  stripeSessionId     String?           @unique
  expiresAt           DateTime?
  transactionExpireAt DateTime?
  usedAt              DateTime?
}

enum GiftCardStatus {
  IN_PROGRESS_PAYMENT
  ACTIVE
  USED
  EXPIRED
}
